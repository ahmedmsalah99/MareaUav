                <mxCell id="20" value="batteryGoneHandler()&#xa;──────────────&#xa;Clear task queue&#xa;Inject: EMERG_LAND task&#xa;(descend to z=0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" parent="1" vertex="1">
