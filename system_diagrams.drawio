    <diagram id="camerafsm" name="3. Camera FSM">
        <mxGraphModel dx="2503" dy="630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Camera FSM — Raspberry Pi Camera Node" style="text;html=1;fontStyle=1;fontSize=16;align=center;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="600" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="470" y="70" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="IDLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="390" y="130" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="LANDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="130" y="370" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="SEARCH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="650" y="370" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="STOP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="390" y="580" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="3" target="10" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="flightMode == FM_LAND&#xa;(release camera, 2s delay)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="10" target="11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="flightMode == FM_SEARCH&#xa;(release camera, 2s delay)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="10" target="12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="flightMode == FM_STOP" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" edge="1">
                    <mxGeometry x="-0.2105" relative="1" as="geometry">
                        <mxPoint x="530" y="200" as="sourcePoint"/>
                        <mxPoint x="530" y="580" as="targetPoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="24" value="otherwise: open camera,&#xa;publish camera_info" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;curved=1;" parent="1" source="10" target="10" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="620" y="165"/>
                            <mxPoint x="620" y="130"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="25" value="prevMode==LAND&#xa;&amp;&amp; mode==SEARCH" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="11" target="12" edge="1">
                    <mxGeometry x="-0.6875" y="25" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="26" value="prevMode==SEARCH&#xa;&amp;&amp; mode==LAND" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="12" target="11" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="750" y="460"/>
                            <mxPoint x="750" y="510"/>
                            <mxPoint x="230" y="510"/>
                            <mxPoint x="230" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="27" value="prevMode==LAND &amp;&amp; mode==STOP" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="11" target="13" edge="1">
                    <mxGeometry x="0.1273" y="-20" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="430" y="405"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="28" value="prevMode==SEARCH &amp;&amp; mode==STOP" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="12" target="13" edge="1">
                    <mxGeometry x="-0.5692" y="45" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="500" y="390"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="29" value="flightMode != FM_STOP" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" parent="1" source="13" target="10" edge="1">
                    <mxGeometry x="0.2295" y="-10" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="350" y="615"/>
                            <mxPoint x="310" y="615"/>
                            <mxPoint x="310" y="165"/>
                            <mxPoint x="390" y="165"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="30" value="Actions:&#xa;• Open camera (if mode set)&#xa;• Publish camera_info (heartbeat)" style="text;html=1;align=left;fontSize=10;strokeColor=#6c8ebf;fillColor=#EEF5FF;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="80" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="Actions:&#xa;• Open camera (3s stabilize)&#xa;• Grab &amp; JPEG-compress frame&#xa;• Publish /apriltag/image/compressed&#xa;• Publish camera_info" style="text;html=1;align=left;fontSize=10;strokeColor=#82b366;fillColor=#F0FFF0;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="-190" y="374" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="32" value="Actions:&#xa;• Same as LANDING&#xa;• Targets rescue tags instead" style="text;html=1;align=left;fontSize=10;strokeColor=#82b366;fillColor=#F0FFF0;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="870" y="475" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="Actions:&#xa;• Release camera&#xa;• Sleep 1s per tick" style="text;html=1;align=left;fontSize=10;strokeColor=#b85450;fillColor=#FFF0F0;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="620" y="580" width="220" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="safety" name="4. Safety &amp; Task Flow">
