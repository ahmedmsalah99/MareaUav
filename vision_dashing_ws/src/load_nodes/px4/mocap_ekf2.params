# PX4 (v1.16) parameters to fly on motion capture instead of GPS.
# Used for M2M_MODE=3 (mocap in sim) and M2M_MODE=1 (mocap lab).
# Paste the `param set` lines into the PX4 shell (pxh> in SITL, MAVLink console in QGC on the drone),
# then `param save` and reboot PX4. Check each name/value in QGC's parameter list for your PX4 version.
#
# mocap_bridge publishes the drone pose on /fmu/in/vehicle_visual_odometry (NED/FRD, position + attitude).

param set EKF2_GPS_CTRL 0        # do not fuse GPS (none indoors; in sim the simulated GPS is ignored)
param set EKF2_EV_CTRL 11        # fuse external vision: horizontal position (1) + vertical position (2) + yaw (8)
param set EKF2_HGT_REF 3         # height reference = vision
param set EKF2_BARO_CTRL 0       # do not fuse the barometer (drifts indoors, conflicts with mocap height)
param set EKF2_MAG_TYPE 5        # no magnetometer fusion: heading comes from mocap (indoor magnetic field is unreliable)
param set EKF2_EV_NOISE_MD 0     # use the variances sent in the message (mocap_bridge.yaml position_std_m / orientation_std_rad)
param set EKF2_EV_DELAY 0        # [ms] mocap-to-PX4 delay. 0 in sim; in the lab measure/tune it (typically a few ms to ~20 ms over Wi-Fi)
param set COM_ARM_WO_GPS 1       # allow arming without a GPS fix

# To go back to normal GPS flight (M2M_MODE=0):
#   param set EKF2_GPS_CTRL 7 ; param set EKF2_EV_CTRL 0 ; param set EKF2_HGT_REF 1
#   param set EKF2_BARO_CTRL 1 ; param set EKF2_MAG_TYPE 0
# (or `param reset_all` to return to the airframe defaults)
