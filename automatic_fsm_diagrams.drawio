                <mxCell id="12" value="HOVERING&#xa;───────────────────&#xa;hold last known&#xa;position (no target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" parent="1" vertex="1">
