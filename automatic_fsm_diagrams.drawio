  <!-- ═══════════════════════════════════════════════════════
       PAGE 1 – TOP-LEVEL COMMAND DISPATCHER
       ═══════════════════════════════════════════════════════ -->
  <diagram id="cmdfsm" name="1. Command Dispatcher">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="2" value="Automatic — Top-Level Command Dispatcher" style="text;html=1;fontStyle=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- ── TASK QUEUE / EXECUTIONER ── -->
        <mxCell id="5" value="Task Queue&#xa;(deque&lt;exec::task&gt;)" style="shape=mxgraph.flowchart.stored_data;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="Executioner::run()&#xa;50 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="5" target="6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ── COMMAND STATES ── -->
        <!-- IDLE -->
        <mxCell id="10" value="IDLE&#xa;────────&#xa;Hold current X,Y,Z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="310" width="180" height="70" as="geometry"/>
        </mxCell>
        <!-- TAKE_OFF -->
        <mxCell id="11" value="TAKE_OFF&#xa;────────&#xa;Hold X,Y; climb to params[0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="195" height="70" as="geometry"/>
        </mxCell>
        <!-- MOVE -->
        <mxCell id="12" value="MOVE&#xa;────────&#xa;Fly to (x,y,z,yaw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="195" height="70" as="geometry"/>
        </mxCell>
        <!-- ROTATE -->
        <mxCell id="13" value="ROTATE&#xa;────────&#xa;Yaw to target bearing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="195" height="70" as="geometry"/>
        </mxCell>
        <!-- LAND -->
        <mxCell id="14" value="LAND&#xa;────────&#xa;params[0]=0: simple land&#xa;params[0]=1: Lander FSM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="310" width="210" height="80" as="geometry"/>
        </mxCell>
        <!-- SEARCH -->
        <mxCell id="15" value="SEARCH&#xa;────────&#xa;Searcher FSM&#xa;→ release payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="430" width="210" height="80" as="geometry"/>
        </mxCell>
        <!-- EMERG_LAND -->
        <mxCell id="16" value="EMERG_LAND&#xa;────────&#xa;Descend immediately&#xa;(never completes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="550" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- ── DISPATCH ARROWS from Executioner ── -->
        <mxCell id="20" value="action==IDLE&#xa;(queue empty)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="6" target="10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="21" value="action==TAKE_OFF" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="6" target="11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="22" value="action==MOVE" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="6" target="12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="23" value="action==ROTATE" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="6" target="13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" value="action==LAND" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="6" target="14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="25" value="action==SEARCH" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="6" target="15" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="26" value="action==EMERG_LAND&#xa;(safety inject)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#b85450;fontColor=#b85450;" edge="1" source="6" target="16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ── COMPLETION ARROWS (back to Executioner for next task) ── -->
        <mxCell id="30" value="z ≥ params[0] − tol" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" source="11" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="155" y="380"/><mxPoint x="155" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="31" value="dist(x,y,z) &lt; tol" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" source="12" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="155" y="500"/><mxPoint x="420" y="500"/><mxPoint x="420" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="32" value="|yaw_err| &lt; tol" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" source="13" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="155" y="620"/><mxPoint x="420" y="620"/><mxPoint x="420" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="33" value="landed=true" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" source="14" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1060" y="390"/><mxPoint x="1060" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="34" value="payload released&#xa;&amp;&amp; nav done" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;" edge="1" source="15" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1060" y="510"/><mxPoint x="1100" y="510"/><mxPoint x="1100" y="200"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- ── ANNOTATIONS ── -->
        <mxCell id="40" value="Lander FSM&#xa;(see page 2)" style="text;html=1;fontSize=9;fontStyle=2;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="395" width="100" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="Searcher FSM&#xa;(see page 3)" style="text;html=1;fontSize=9;fontStyle=2;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="515" width="100" height="35" as="geometry"/>
        </mxCell>

        <!-- Safety override -->
        <mxCell id="45" value="SafetyHandlerNode&#xa;(battery / camera / GPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="680" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="46" value="Clear queue, inject safety tasks" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" source="45" target="5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="410" y="710"/><mxPoint x="410" y="90"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="50" value="─── dispatch" style="text;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="51" value="- - - task complete" style="text;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="130" height="20" as="geometry"/></mxCell>

