  </diagram>

  <!-- ═══════════════════════════════════════════════════════
       PAGE 2 – LANDING FSM (Lander)
       ═══════════════════════════════════════════════════════ -->
  <diagram id="lander" name="2. Landing FSM">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="2" value="Lander FSM  (active when LAND task with params[0]=1)" style="text;html=1;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- Start -->
        <mxCell id="3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="495" y="60" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- ── STATES ── -->
        <!-- INIT -->
        <mxCell id="10" value="INIT&#xa;────────────────────&#xa;align yaw to platform&#xa;position drone in front" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="220" height="80" as="geometry"/>
        </mxCell>
        <!-- INSPE -->
        <mxCell id="11" value="INSPE&#xa;──────────────────&#xa;fly circular search&#xa;pattern (inspection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="210" height="80" as="geometry"/>
        </mxCell>
        <!-- HOVERING -->
        <mxCell id="12" value="HOVERING&#xa;──────────────────&#xa;hold starting position&#xa;(no vision, no search)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="290" width="215" height="80" as="geometry"/>
        </mxCell>
        <!-- HOLD -->
        <mxCell id="13" value="HOLD&#xa;──────────────────&#xa;PID-track platform&#xa;horizontally (vision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="220" height="80" as="geometry"/>
        </mxCell>
        <!-- DESC -->
        <mxCell id="14" value="DESC&#xa;──────────────&#xa;descend 10 cm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="660" width="170" height="70" as="geometry"/>
        </mxCell>
        <!-- ASCE -->
        <mxCell id="15" value="ASCE&#xa;──────────────&#xa;ascend 10 cm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="660" width="170" height="70" as="geometry"/>
        </mxCell>
        <!-- R2LA -->
        <mxCell id="16" value="R2LA&#xa;────────────────────&#xa;clamp Z setpoint&#xa;accumulate NComp frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="660" width="220" height="80" as="geometry"/>
        </mxCell>
        <!-- COMP -->
        <mxCell id="17" value="COMP&#xa;────────────────────&#xa;velocity-based altitude&#xa;compensation (hold+comp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="840" width="220" height="80" as="geometry"/>
        </mxCell>
        <!-- LAND -->
        <mxCell id="18" value="LAND  ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="1020" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- ── TRANSITIONS ── -->
        <!-- Start → INIT -->
        <mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="3" target="10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INIT → HOLD -->
        <mxCell id="31" value="vision valid &amp;&amp;&#xa;ready_to_land" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="10" target="13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INIT → INSPE -->
        <mxCell id="32" value="no vision 20+ iters&#xa;&amp;&amp; search=true" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="10" target="11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INIT → HOVERING -->
        <mxCell id="33" value="no vision 20+ iters&#xa;&amp;&amp; search=false" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="10" target="12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INSPE → INIT -->
        <mxCell id="34" value="vision valid" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="11" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="60" y="330"/><mxPoint x="60" y="150"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOVERING → INIT -->
        <mxCell id="35" value="vision valid &amp;&amp; IsValid" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="12" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="960" y="330"/><mxPoint x="960" y="150"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOLD → DESC -->
        <mxCell id="36" value="holding &amp;&amp; z &gt; zMin" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- HOLD → ASCE -->
        <mxCell id="37" value="lost &amp;&amp; z &lt; zMax" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="15" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- HOLD → INIT -->
        <mxCell id="38" value="no vision &amp;&amp;&#xa;z &lt; zMax" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="390" y="520"/><mxPoint x="340" y="520"/><mxPoint x="340" y="150"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOLD → HOVERING -->
        <mxCell id="39" value="no vision data&#xa;&amp;&amp; z ≥ zMax" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="630" y="520"/><mxPoint x="840" y="520"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOLD → R2LA -->
        <mxCell id="40" value="centered &amp;&amp;&#xa;wait &gt; 10 frames" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- DESC → HOLD -->
        <mxCell id="41" value="always" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="14" target="13" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="215" y="695"/><mxPoint x="215" y="520"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- ASCE → HOLD -->
        <mxCell id="42" value="always" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="15" target="13" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="805" y="695"/><mxPoint x="805" y="520"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- R2LA → COMP -->
        <mxCell id="43" value="NComp &gt; NFramesComp" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="16" target="17" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- R2LA → HOLD -->
        <mxCell id="44" value="not centered" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="16" target="13" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="390" y="700"/><mxPoint x="360" y="700"/><mxPoint x="360" y="520"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- COMP → ASCE (multiple reasons) -->
        <mxCell id="45" value="not on_target || not_centered&#xa;| no ultrasonic | roll/pitch &gt; thr" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="17" target="15" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="630" y="880"/><mxPoint x="900" y="880"/><mxPoint x="900" y="695"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- COMP → HOVERING -->
        <mxCell id="46" value="not vision valid" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="17" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="630" y="880"/><mxPoint x="960" y="880"/><mxPoint x="960" y="330"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- COMP → LAND -->
        <mxCell id="47" value="on_target &amp;&amp; centered&#xa;&amp;&amp; vert_err &lt; land_threshold" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" edge="1" source="17" target="18" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ── SENSOR NOTE ── -->
        <mxCell id="55" value="Altitude source switch (in HOLD/COMP/DESC):&#xa;  z &gt; 0.83 m → use vision Z&#xa;  z ≤ 0.83 m → use ultrasonic Z (− sensor offset)" style="text;html=1;align=left;fontSize=11;fillColor=#EEF5FF;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="850" width="350" height="70" as="geometry"/>
        </mxCell>

        <!-- ── PID NOTE ── -->
        <mxCell id="56" value="HOLD / COMP / R2LA use PID:&#xa;  xTarget = PID_X(0, vision.X)&#xa;  yTarget = PID_Y(0, vision.Y)&#xa;Gains: KpHold, KiHold, KdHold" style="text;html=1;align=left;fontSize=11;fillColor=#F0FFF0;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="840" width="300" height="75" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════
       PAGE 3 – SEARCH / RESCUE FSM (Searcher)
       ═══════════════════════════════════════════════════════ -->
  <diagram id="searcher" name="3. Search/Rescue FSM">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="2" value="Searcher FSM  (active during SEARCH task)" style="text;html=1;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Start -->
        <mxCell id="3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="485" y="55" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- ── STATES ── -->
        <!-- INIT -->
        <mxCell id="10" value="INIT&#xa;─────────────────────&#xa;align yaw to target&#xa;position drone above target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="240" height="80" as="geometry"/>
        </mxCell>
        <!-- INSPE -->
        <mxCell id="11" value="INSPE&#xa;───────────────────&#xa;fly circular search&#xa;for rescue target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="210" height="80" as="geometry"/>
        </mxCell>
        <!-- HOVERING -->
        <mxCell id="12" value="HOVERING&#xa;───────────────────&#xa;hold last known&#xa;position (no target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="290" width="210" height="80" as="geometry"/>
        </mxCell>
        <!-- HOLD -->
        <mxCell id="13" value="HOLD&#xa;─────────────────────&#xa;PID-track rescue target&#xa;horizontally (vision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="240" height="80" as="geometry"/>
        </mxCell>
        <!-- RELEASE -->
        <mxCell id="14" value="RELEASE  ✓&#xa;─────────────────────&#xa;publish release_payload&#xa;wait for feedback &#39;R&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="660" width="240" height="80" as="geometry"/>
        </mxCell>

        <!-- ── TRANSITIONS ── -->
        <!-- Start → INIT -->
        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="3" target="10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INIT → HOLD -->
        <mxCell id="21" value="vision_updated&#xa;10+ consecutive frames" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="10" target="13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INIT → INSPE -->
        <mxCell id="22" value="no vision&#xa;10+ iters" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="10" target="11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- INSPE → INIT -->
        <mxCell id="23" value="vision_updated" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="11" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="60" y="330"/><mxPoint x="60" y="150"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOVERING → INIT -->
        <mxCell id="24" value="vision_valid &amp;&amp;&#xa;vision_updated" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="12" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="940" y="330"/><mxPoint x="940" y="150"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOLD → RELEASE -->
        <mxCell id="25" value="holding &amp;&amp; positioned&#xa;&amp;&amp; !payloadReleased" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" edge="1" source="13" target="14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- HOLD → HOVERING -->
        <mxCell id="26" value="not vision_valid" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="12" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="630" y="510"/><mxPoint x="815" y="510"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- HOLD → INIT -->
        <mxCell id="27" value="no vision data &amp;&amp;&#xa;!payloadReleased &amp;&amp; wait&gt;20" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="13" target="10" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="370" y="510"/><mxPoint x="320" y="510"/><mxPoint x="320" y="150"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- RELEASE → HOLD (stays until released, loops) -->
        <mxCell id="28" value="payload released&#xa;(keeps in HOLD)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" source="14" target="13" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="630" y="700"/><mxPoint x="680" y="700"/><mxPoint x="680" y="510"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- ── NOTES ── -->
        <mxCell id="35" value="After RELEASE: Executioner waits for&#xa;  1. payload feedback == &#39;R&#39;&#xa;  2. nav_mission_finished == true&#xa;Then pops SEARCH task → next task runs." style="text;html=1;align=left;fontSize=11;fillColor=#EEF5FF;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="630" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="Inspection parameters:&#xa;  params[0]: radius&#xa;  params[1]: linear velocity&#xa;  task.z:    search altitude" style="text;html=1;align=left;fontSize=11;fillColor=#F0FFF0;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="600" width="250" height="75" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════
       PAGE 4 – SIM vs REAL SYSTEM
